---
// ヘッダーの ⌘K で開くサイト内全文検索。
// 索引はブラウザ側で組む（/search-index.json を初回オープン時に取りに行く）ため、
// 通常のページ読み込みには一切コストがかからない。
---

<button type="button" id="search-trigger" class="search-trigger" aria-haspopup="dialog">
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
  </svg>
  <span>検索</span>
  <kbd class="search-kbd" id="search-kbd">⌘K</kbd>
</button>

<dialog id="search-dialog" class="search-dialog" aria-label="サイト内検索">
  <div class="search-head">
    <label class="search-visually-hidden" for="search-input">サイト内を検索</label>
    <input
      id="search-input"
      type="text"
      class="search-input"
      placeholder="メモ・ニュース・外部記事を検索"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <button type="button" id="search-close" class="search-close">esc</button>
  </div>
  <p id="search-status" class="search-status" role="status" aria-live="polite"></p>
  <ul id="search-results" class="search-results" role="listbox" aria-label="検索結果"></ul>
  <p class="search-hint">
    <kbd>↑</kbd><kbd>↓</kbd> で移動 · <kbd>Enter</kbd> で開く
  </p>
</dialog>

<script>
  import type { AnyOrama } from '@orama/orama';

  interface SearchDoc {
    id: string;
    type: 'memo' | 'news' | 'external';
    title: string;
    description: string;
    tags: string;
    body: string;
    url: string;
    pubDate: string;
    source: string;
  }

  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const trigger = document.getElementById('search-trigger');
  const closeBtn = document.getElementById('search-close');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const statusEl = document.getElementById('search-status');
  const resultsEl = document.getElementById('search-results');
  const kbdEl = document.getElementById('search-kbd');

  if (dialog && trigger && input && statusEl && resultsEl) {
    const isMac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
    if (kbdEl) kbdEl.textContent = isMac ? '⌘K' : 'Ctrl K';

    let db: AnyOrama | null = null;
    let indexing: Promise<void> | null = null;
    let hits: SearchDoc[] = [];
    let active = -1;

    /** 初回オープン時にだけ索引を組む。以後は使い回す */
    function ensureIndex(): Promise<void> {
      if (!indexing) {
        indexing = (async () => {
          const [orama, ja, res] = await Promise.all([
            import('@orama/orama'),
            import('ja-bigram-tokenizer/orama'),
            fetch('/search-index.json'),
          ]);
          const { docs } = (await res.json()) as { docs: SearchDoc[] };
          const instance = orama.create({
            schema: {
              title: 'string',
              description: 'string',
              tags: 'string',
              body: 'string',
            },
            // create() に language は渡せない（カスタムtokenizerと併用すると
            // NO_LANGUAGE_WITH_CUSTOM_TOKENIZER で落ちる）
            components: { tokenizer: ja.createJaTokenizer() },
          });
          await orama.insertMultiple(instance, docs as never[]);
          db = instance;
        })().catch((e) => {
          // 失敗したら次回オープンで組み直せるようにしておく
          indexing = null;
          throw e;
        });
      }
      return indexing;
    }

    function setActive(next: number) {
      const items = resultsEl!.querySelectorAll<HTMLLIElement>('li');
      if (items.length === 0) return;
      active = (next + items.length) % items.length;
      items.forEach((li, i) => {
        const on = i === active;
        li.classList.toggle('is-active', on);
        li.setAttribute('aria-selected', String(on));
        if (on) {
          input!.setAttribute('aria-activedescendant', li.id);
          li.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    function render(docs: SearchDoc[], term: string) {
      hits = docs;
      active = -1;
      resultsEl!.replaceChildren();
      input!.removeAttribute('aria-activedescendant');
      input!.setAttribute('aria-expanded', String(docs.length > 0));

      for (const [i, doc] of docs.entries()) {
        const li = document.createElement('li');
        li.id = `search-result-${i}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');

        const a = document.createElement('a');
        a.href = doc.url;
        if (doc.type === 'external') {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        }

        const head = document.createElement('span');
        head.className = 'search-result-head';
        const badge = document.createElement('span');
        badge.className = 'badge';
        // ラベルは source をそのまま出す。一覧ページのバッジ（hatena / note /
        // memo …）と表記を揃えるため
        badge.dataset.source = doc.source;
        badge.textContent = doc.source;
        const title = document.createElement('span');
        title.className = 'search-result-title';
        title.textContent = doc.title;
        head.append(badge, title);

        a.append(head);

        const snippet = excerpt(doc, term);
        if (snippet) {
          const p = document.createElement('p');
          p.className = 'search-result-snippet';
          p.textContent = snippet;
          a.append(p);
        }

        li.append(a);
        // マウスで乗せたときもキーボードの選択位置を合わせる
        li.addEventListener('mousemove', () => setActive(i));
        resultsEl!.append(li);
      }
    }

    /** 本文中でヒット箇所の周辺を切り出す。無ければ description にフォールバック */
    function excerpt(doc: SearchDoc, term: string): string {
      const body = doc.body;
      if (body && term) {
        const at = body.toLowerCase().indexOf(term.toLowerCase());
        if (at >= 0) {
          const from = Math.max(0, at - 30);
          const text = body.slice(from, from + 120);
          return (from > 0 ? '…' : '') + text + (from + 120 < body.length ? '…' : '');
        }
      }
      if (doc.description) return doc.description;
      return body ? body.slice(0, 120) + (body.length > 120 ? '…' : '') : '';
    }

    async function runSearch(term: string) {
      const q = term.trim();
      if (!q) {
        render([], '');
        statusEl!.textContent = '';
        return;
      }
      statusEl!.textContent = '検索中…';
      try {
        await ensureIndex();
      } catch {
        statusEl!.textContent = '索引の読み込みに失敗しました';
        return;
      }
      // 入力が進んでいたらこの結果は捨てる
      if (input!.value.trim() !== q) return;

      // 全トークンを含むページだけに絞り、0件なら文章クエリとみなしてORに落とす
      // 2パスは searchJa の中身。fuzzy がそのフォールバックが起きたかを返す
      const { searchJa } = await import('ja-bigram-tokenizer/orama');
      const { hits, count, fuzzy } = await searchJa<SearchDoc>(db as AnyOrama, {
        term: q,
        limit: 20,
        boost: { title: 3, description: 1.5, tags: 2 },
      });

      if (input!.value.trim() !== q) return;
      // ORは全トークンを含まなくても当たるので、存在しない語だと数十件がほぼ横並びの
      // スコアで返る。上位だけ出して「近いもの」だと明示する
      const docs = fuzzy ? hits.slice(0, 5) : hits;
      render(docs, q);
      statusEl!.textContent =
        docs.length === 0
          ? `「${q}」に一致する記事はありません`
          : fuzzy
            ? `完全一致なし — 近いもの ${docs.length} 件`
            : `${count} 件`;
    }

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => void runSearch(input.value), 120);
    });

    function open() {
      if (dialog!.open) return;
      dialog!.showModal();
      input!.select();
      // 開いた瞬間に索引を組み始めておく。入力までの間に間に合うことが多い
      void ensureIndex().catch(() => {});
    }

    trigger.addEventListener('click', open);
    closeBtn?.addEventListener('click', () => dialog.close());

    // 背景クリックで閉じる（dialog自身がバックドロップ領域も含むので座標で判定）
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      input!.setAttribute('aria-expanded', 'false');
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) dialog.close();
        else open();
        return;
      }
      if (!dialog.open) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter' && active >= 0 && hits[active]) {
        e.preventDefault();
        const link = resultsEl.querySelectorAll('a')[active] as HTMLAnchorElement | undefined;
        link?.click();
      }
    });
  }
</script>

<style>
  .search-trigger {
    background: none;
    border: 1px solid transparent;
    border-radius: 4px;
    cursor: pointer;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-family: inherit;
    padding: 2px 6px;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.2s, border-color 0.2s;
    white-space: nowrap;
  }

  .search-trigger:hover {
    color: var(--color-text);
    border-color: var(--color-border-dark);
  }

  .search-kbd,
  .search-hint kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1;
    padding: 2px 4px;
    border: 1px solid var(--color-border-dark);
    border-radius: 3px;
    background: var(--color-surface);
    color: var(--color-text-light);
  }

  .search-dialog {
    width: min(640px, calc(100vw - 2rem));
    max-height: min(70vh, 34rem);
    margin: 12vh auto auto;
    padding: 0;
    border: 2px dashed var(--color-border-dark);
    border-radius: 12px;
    background: var(--color-bg);
    color: var(--color-text);
    box-shadow: 6px 6px 0 var(--color-marker);
    overflow: hidden;
    flex-direction: column;
  }

  /* display は [open] のときだけ与える。ここで無条件に flex にすると
     UAスタイルの dialog:not([open]) { display: none } に勝ってしまい
     （オーサースタイルはUAより優先される）、閉じていても表示されてしまう */
  .search-dialog[open] {
    display: flex;
  }

  .search-dialog::backdrop {
    background: light-dark(rgba(43, 43, 43, 0.35), rgba(0, 0, 0, 0.55));
  }

  .search-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px dashed var(--color-border-dark);
    flex: none;
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    color: var(--color-text);
    font-size: 1rem;
    font-family: inherit;
    padding: 0.25rem 0;
  }

  .search-input:focus {
    outline: none;
  }

  .search-input::placeholder {
    color: var(--color-text-light);
  }

  .search-close {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 3px 6px;
    border: 1px solid var(--color-border-dark);
    border-radius: 3px;
    background: var(--color-surface);
    color: var(--color-text-light);
    cursor: pointer;
  }

  .search-close:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .search-status {
    flex: none;
    padding: 0.4rem 1rem 0;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-text-light);
  }

  .search-status:empty {
    display: none;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    overflow-y: auto;
    flex: 1 1 auto;
  }

  /* 結果の li / a はJS生成なのでAstroのスコープ属性が付かない。
     :global() で内側だけ抜き、.search-results 側でスコープを効かせる */
  .search-results :global(li) {
    border-radius: 8px;
  }

  .search-results :global(a) {
    display: block;
    padding: 0.5rem 0.625rem;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
  }

  .search-results :global(li.is-active) {
    background: var(--color-surface-hover);
    outline: 1px solid var(--color-accent);
  }

  .search-results :global(.search-result-head) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .search-results :global(.search-result-title) {
    font-weight: 600;
    color: var(--color-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-results :global(.search-result-snippet) {
    margin-top: 0.15rem;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-hint {
    flex: none;
    padding: 0.5rem 1rem;
    border-top: 1px dashed var(--color-border-dark);
    font-size: 0.7rem;
    color: var(--color-text-light);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .search-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* 物理キーボードが無い端末では ⌘K / ↑↓ の案内は嘘になるので隠す。
     画面幅ではなく入力デバイスで判定するので、キーボードを付けたiPadでは
     ちゃんと残る（iPadOSなら ⌘K の表記自体も正しい） */
  @media (hover: none) and (pointer: coarse) {
    .search-kbd,
    .search-hint {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .search-trigger span {
      display: none;
    }

    .search-dialog {
      margin-top: 6vh;
    }
  }
</style>
